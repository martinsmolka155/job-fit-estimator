OPENAI_API_KEY=sk-proj-your-key-here

# Per-stage model selection (optional — defaults shown)
# PARSER_MODEL=gpt-4o-mini
# EXPLAINER_MODEL=gpt-5-mini

DAILY_API_BUDGET_USD=5.00

# Per-IP rate limit for the public HTTP API (defaults shown): at most
# RATE_LIMIT_MAX_REQUESTS analyses per RATE_LIMIT_WINDOW_SECONDS per client IP.
# RATE_LIMIT_MAX_REQUESTS=5
# RATE_LIMIT_WINDOW_SECONDS=3600

# Cloudflare Turnstile bot challenge. Leave both empty to disable (form skips
# the widget, server skips verification). Set both to activate on public deploy.
# Get keys at https://dash.cloudflare.com → Turnstile → Add site.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
